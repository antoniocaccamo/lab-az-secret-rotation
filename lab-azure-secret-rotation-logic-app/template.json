            "type": "String"
        },
        "workflows_secret_logicapp_mail_send_name": {
            "defaultValue": "secret-logicapp-mail-send",
            "type": "String"
        },
        "topics_evtgrid_secret_logicapp_sendmail_topic_name": {
            "defaultValue": "evtgrid-secret-logicapp-sendmail-topic",
            "type": "String"
        },
        "userAssignedIdentities_mi_secret_rotation_enterprise_app_rotate_name": {
            "defaultValue": "mi-secret-rotation-enterprise-app-rotate",
            "type": "String"
        }
    },
    "variables": {},
