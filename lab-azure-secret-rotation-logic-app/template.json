            "properties": {
                "minimumTlsVersionAllowed": "1.0",
                "inputSchema": "EventGridSchema",
                "publicNetworkAccess": "Enabled",
                "disableLocalAuth": false,
                "dataResidencyBoundary": "WithinGeopair"
            }
        },
        {
            "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
            "apiVersion": "2023-01-31",
            "name": "[parameters('userAssignedIdentities_mi_secret_rotation_enterprise_app_rotate_name')]",
            "location": "northeurope"
        },
        {
            "type": "Microsoft.Web/connections",
            "apiVersion": "2016-06-01",
            "name": "[parameters('connections_azureeventgrid_1_name')]",
            "location": "northeurope",
            "kind": "V1",
            "properties": {
                "displayName": "sendmail-event-grid",
                "statuses": [
                    {
                        "status": "Ready"
                    }
                ],
                "customParameterValues": {},
                "createdTime": "2023-09-22T15:26:04.9096297Z",
                "changedTime": "2023-09-22T15:26:04.9096297Z",
                "api": {
                    "name": "azureeventgrid",
                    "displayName": "Azure Event Grid",
                    "description": "Azure Event Grid is an eventing backplane that enables event based programing with pub/sub semantics and reliable distribution & delivery for all services in Azure as well as third parties.",
                    "iconUri": "https://connectoricons-prod.azureedge.net/u/shgogna/globalperconnector-train1/1.0.1639.3310/azureeventgrid/icon.png",
                    "brandColor": "#0072c6",
                    "id": "/subscriptions/908894ac-5f7e-40ea-ab31-f2cdf88a53e3/providers/Microsoft.Web/locations/northeurope/managedApis/azureeventgrid",
                    "type": "Microsoft.Web/locations/managedApis"
                },
                "testLinks": []
            }
        },
        {
            "type": "Microsoft.Web/connections",
            "apiVersion": "2016-06-01",
            "name": "[parameters('connections_outlook_name')]",
            "location": "northeurope",
            "kind": "V1",
            "properties": {
                "displayName": "Outlook.com",
                "statuses": [
                    {
                        "status": "Connected"
                    }
                ],
                "customParameterValues": {},
                "nonSecretParameterValues": {},
                "createdTime": "2023-09-22T15:20:05.5927094Z",
                "changedTime": "2023-09-25T10:50:53.5302073Z",
                "api": {
                    "name": "[parameters('connections_outlook_name')]",
                    "displayName": "Outlook.com",
                    "description": "Outlook.com connector allows you to manage your mail, calendars, and contacts. You can perform various actions such as send mail, schedule meetings, add contacts, etc.",
                    "iconUri": "[concat('https://connectoricons-prod.azureedge.net/u/laborbol/partial-builds/ase-v3/1.0.1653.3402/', parameters('connections_outlook_name'), '/icon.png')]",
                    "brandColor": "#0078D4",
                    "id": "[concat('/subscriptions/908894ac-5f7e-40ea-ab31-f2cdf88a53e3/providers/Microsoft.Web/locations/northeurope/managedApis/', parameters('connections_outlook_name'))]",
                    "type": "Microsoft.Web/locations/managedApis"
                },
                "testLinks": [
                    {
                        "requestUri": "[concat('https://management.azure.com:443/subscriptions/908894ac-5f7e-40ea-ab31-f2cdf88a53e3/resourceGroups/rg-secret-logicapp-sendmail/providers/Microsoft.Web/connections/', parameters('connections_outlook_name'), '/extensions/proxy/testconnection?api-version=2016-06-01')]",
                        "method": "get"
                    }
                ]
            }
        },
        {
            "type": "Microsoft.EventGrid/topics/eventSubscriptions",
            "apiVersion": "2023-06-01-preview",
            "name": "[concat(parameters('topics_evtgrid_secret_logicapp_sendmail_topic_name'), '/LogicAppfb2a5883-4d6f-4518-b10e-4cb2c1758b65')]",
            "dependsOn": [
                "[resourceId('Microsoft.EventGrid/topics', parameters('topics_evtgrid_secret_logicapp_sendmail_topic_name'))]"
            ],
            "properties": {
                "destination": {
                    "properties": {
                        "maxEventsPerBatch": 1,
                        "preferredBatchSizeInKilobytes": 64
                    },
                    "endpointType": "WebHook"
                },
                "filter": {},
                "eventDeliverySchema": "EventGridSchema",
                "retryPolicy": {
                    "maxDeliveryAttempts": 30,
                    "eventTimeToLiveInMinutes": 1440
                }
            }
        },
        {
            "type": "Microsoft.Logic/workflows",
            "apiVersion": "2017-07-01",
            "name": "[parameters('workflows_secret_logicapp_mail_send_name')]",
            "location": "northeurope",
            "dependsOn": [
                "[resourceId('Microsoft.EventGrid/topics', parameters('topics_evtgrid_secret_logicapp_sendmail_topic_name'))]",
                "[resourceId('Microsoft.Web/connections', parameters('connections_azureeventgrid_1_name'))]",
                "[resourceId('Microsoft.Web/connections', parameters('connections_outlook_name'))]"
            ],
            "tags": {
                "container": "cloud-security",
                "environment": "dev",
                "project": "secret-rotation",
                "source": "manual"
            },
            "identity": {
                "type": "SystemAssigned"
            },
            "properties": {
                "state": "Enabled",
                "definition": {
                    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "$connections": {
                            "defaultValue": {},
                            "type": "Object"
                        }
                    },
                    "triggers": {
                        "When_a_resource_event_occurs": {
                            "splitOn": "@triggerBody()",
                            "type": "ApiConnectionWebhook",
                            "inputs": {
                                "body": {
                                    "properties": {
                                        "destination": {
                                            "endpointType": "webhook",
                                            "properties": {
                                                "endpointUrl": "@{listCallbackUrl()}"
                                            }
                                        },
                                        "topic": "[resourceId('Microsoft.EventGrid/topics', parameters('topics_evtgrid_secret_logicapp_sendmail_topic_name'))]"
                                    }
                                },
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['azureeventgrid_1']['connectionId']"
                                    }
                                },
                                "path": "/subscriptions/@{encodeURIComponent('908894ac-5f7e-40ea-ab31-f2cdf88a53e3')}/providers/@{encodeURIComponent('Microsoft.EventGrid.Topics')}/resource/eventSubscriptions",
                                "queries": {
                                    "x-ms-api-version": "2017-09-15-preview"
                                }
                            }
                        }
                    },
                    "actions": {
                        "Send_an_email_(V2)": {
                            "runAfter": {},
                            "type": "ApiConnection",
                            "inputs": {
                                "body": {
                                    "Body": "<p>@{triggerBody()['data']['bodyHtml']}</p>",
                                    "Importance": "Normal",
                                    "Subject": "@triggerBody()?['eventType']",
                                    "To": "@{triggerBody()['data']['endusers-recipients']}"
                                },
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['outlook']['connectionId']"
                                    }
                                },
                                "method": "post",
                                "path": "/v2/Mail"
                            }
                        }
                    },
                    "outputs": {}
                },
                "parameters": {
                    "$connections": {
                        "value": {
                            "azureeventgrid_1": {
                                "connectionId": "[resourceId('Microsoft.Web/connections', parameters('connections_azureeventgrid_1_name'))]",
                                "connectionName": "azureeventgrid-1",
                                "connectionProperties": {
                                    "authentication": {
                                        "type": "ManagedServiceIdentity"
                                    }
                                },
                                "id": "/subscriptions/908894ac-5f7e-40ea-ab31-f2cdf88a53e3/providers/Microsoft.Web/locations/northeurope/managedApis/azureeventgrid"
                            },
                            "outlook": {
                                "connectionId": "[resourceId('Microsoft.Web/connections', parameters('connections_outlook_name'))]",
                                "connectionName": "outlook",
                                "id": "/subscriptions/908894ac-5f7e-40ea-ab31-f2cdf88a53e3/providers/Microsoft.Web/locations/northeurope/managedApis/outlook"
                            }
                        }
                    }
                }
            }
        }
    ]
}